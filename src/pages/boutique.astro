---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WarpHero from "../components/react/WarpHero.tsx";
import { produits, shopify, livraison } from "../data/produits";

const vedette = produits.find((p) => p.vedette)!;
const autres = produits.filter((p) => !p.vedette);

// Données passées au SDK Shopify (un seul panier partagé pour toute la page)
const shopifyProduits = produits.map((p) => ({ id: p.shopifyId, node: `buy-${p.id}` }));

// Données structurées : un Product par article (rich results Google Shopping organique)
const schemaProduits = produits.map((p) => ({
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.titre,
  image: `https://mobilclean.fr${p.image}`,
  description: p.accroche,
  brand: { "@type": "Brand", name: "Mobil Clean" },
  category: p.categorie,
  offers: {
    "@type": "Offer",
    url: `https://mobilclean.fr/boutique#${p.id}`,
    priceCurrency: "EUR",
    price: p.prix.toFixed(2),
    availability: "https://schema.org/InStock",
    seller: { "@type": "Organization", name: "Mobil Clean" },
  },
}));
---

<Layout
  title="Boutique - Produits d'entretien auto | Mobil Clean"
  description="Les produits d'entretien auto sélectionnés par Mobil Clean : soin du cuir, nettoyant intérieur, nettoyant pneus, protection céramique. Livraison en France et en Europe."
  ogImage="/images/boutique/cuir.jpg"
>
  <Header />

  <main>
    <!-- ================== HERO ================== -->
    <section class="page-hero">
      <WarpHero client:only="react" />
      <div class="page-hero-overlay"></div>
      <div class="container page-hero-content">
        <span class="tag">Boutique</span>
        <h1>Les produits,<br /><span class="accent">entre deux passages</span></h1>
        <p>
          On ne peut pas passer chez vous toutes les semaines. Voici la sélection
          d'entretien qu'on recommande pour tenir un intérieur et une carrosserie
          propres entre deux interventions.
        </p>
      </div>
    </section>

    <!-- ================== RÉASSURANCE ================== -->
    <section class="reassurance">
      <div class="container reassurance-grid">
        <div class="reassurance-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13" /><path d="M16 8h4l3 3v5h-7V8z" />
            <circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
          <div>
            <strong>Livraison {livraison.zone}</strong>
            <span>Suivi de colis par email</span>
          </div>
        </div>
        <div class="reassurance-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <div>
            <strong>Paiement sécurisé</strong>
            <span>Carte, Apple Pay, Google Pay</span>
          </div>
        </div>
        <div class="reassurance-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <div>
            <strong>Sélection du métier</strong>
            <span>Ce qu'on utilise en intervention</span>
          </div>
        </div>
        <div class="reassurance-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
          </svg>
          <div>
            <strong>Délai : {livraison.delai}</strong>
            <span>Annoncé avant commande</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================== PRODUIT VEDETTE ================== -->
    <section class="vedette-section">
      <div class="container">
        <article id={vedette.id} class="vedette reveal">
          <div class="vedette-media">
            <img src={vedette.image} alt={vedette.alt} width="875" height="875" loading="eager" />
            <span class="badge-contenance">{vedette.contenance}</span>
          </div>

          <div class="vedette-corps">
            <span class="eyebrow">{vedette.categorie}</span>
            <h2>{vedette.titre}</h2>
            <p class="soustitre">{vedette.soustitre}</p>
            <p class="accroche">{vedette.accroche}</p>

            <ul class="points">
              {vedette.points.map((pt) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {pt}
                </li>
              ))}
            </ul>

            {vedette.astuce && <p class="astuce"><strong>Le rituel.</strong> {vedette.astuce}</p>}
            {vedette.reserve && <p class="reserve">{vedette.reserve}</p>}

            <div class="achat">
              <div class="prix-bloc">
                <span class="prix">{vedette.prixAffiche}</span>
                <span class="prix-mention">TTC · {vedette.contenance}</span>
              </div>
              <div class="buy-mount" id={`buy-${vedette.id}`} data-buy-mount></div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ================== GRILLE PRODUITS ================== -->
    <section class="grille-section">
      <div class="container">
        <header class="section-head reveal">
          <span class="tag">Le reste de la gamme</span>
          <h2>Trois sprays, trois usages</h2>
          <p>Habitacle, pneus, carrosserie. Pas de gadget : chaque produit répond à un problème précis.</p>
        </header>

        <div class="grille">
          {autres.map((p, i) => (
            <article id={p.id} class={`carte reveal reveal-delay-${i + 1}`}>
              <div class="carte-media">
                <img src={p.image} alt={p.alt} width="1600" height="1600" loading="lazy" />
                <span class="badge-contenance">{p.contenance}</span>
              </div>

              <div class="carte-corps">
                <span class="eyebrow">{p.categorie}</span>
                <h3>{p.titre}</h3>
                <p class="soustitre">{p.soustitre}</p>
                <p class="accroche">{p.accroche}</p>

                <ul class="points">
                  {p.points.map((pt) => (
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      {pt}
                    </li>
                  ))}
                </ul>

                {p.astuce && <p class="astuce"><strong>Conseil.</strong> {p.astuce}</p>}

                <div class="achat">
                  <div class="prix-bloc">
                    <span class="prix">{p.prixAffiche}</span>
                    <span class="prix-mention">TTC · {p.contenance}</span>
                  </div>
                  <div class="buy-mount" id={`buy-${p.id}`} data-buy-mount></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ================== LIVRAISON / TRANSPARENCE ================== -->
    <section class="infos-section">
      <div class="container infos-grid">
        <div class="infos-intro reveal">
          <span class="tag">Commande & livraison</span>
          <h2>Ce qu'il faut savoir avant de commander</h2>
          <p>
            Pas de mauvaise surprise : voici comment ça se passe, du clic à la
            boîte aux lettres.
          </p>
        </div>

        <ul class="infos-liste reveal reveal-delay-1">
          <li>
            <strong>Délai de livraison : {livraison.delai}</strong>
            <span>
              Nos produits d'entretien sont expédiés depuis notre fournisseur
              partenaire. Le délai est plus long qu'un colis classique — on
              préfère l'annoncer clairement plutôt que de le cacher.
            </span>
          </li>
          <li>
            <strong>Suivi systématique</strong>
            <span>Un numéro de suivi vous est envoyé par email dès le départ du colis.</span>
          </li>
          <li>
            <strong>Zone d'expédition</strong>
            <span>{livraison.zone}.</span>
          </li>
          <li>
            <strong>Droit de rétractation : 14 jours</strong>
            <span>
              Comme pour tout achat en ligne, vous disposez de 14 jours après
              réception pour changer d'avis, produit non ouvert.
            </span>
          </li>
          <li>
            <strong>Une question sur un produit&nbsp;?</strong>
            <span>
              Écrivez-nous à <a href="mailto:Mobilclean68@gmail.com">Mobilclean68@gmail.com</a>
              ou appelez le <a href="tel:+33768445293">07 68 44 52 93</a>.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================== CTA SERVICE ================== -->
    <section class="cta-service">
      <div class="container cta-inner reveal">
        <div>
          <h2>Vous préférez qu'on s'en occupe&nbsp;?</h2>
          <p>
            Un produit ne remplace pas une injection-extraction. Pour un
            habitacle, un matelas ou un canapé remis à neuf, on se déplace chez
            vous en Alsace.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn-teal">Demander un devis</a>
          <a href="/services" class="btn-outline">Voir les prestations</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Données structurées produits -->
  {schemaProduits.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</Layout>

<!--
  Shopify Buy Button — un SEUL client et une SEULE instance UI pour les 4
  produits, afin de partager un panier unique (les extraits générés par Shopify
  créent sinon 4 paniers et 4 icônes flottantes).
  Les cartes produit sont dessinées par le site ; Shopify ne fournit que le
  bouton « Ajouter au panier », le panier et le paiement.
-->
<script define:vars={{ shopify, shopifyProduits }}>
  (function () {
    var SDK = "https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js";

    var NAVY = "#0D3080";
    var TEAL = "#00C896";
    var TEAL_FONCE = "#00A87C";
    var TEXTE = "#0D1B3E";
    var TEXTE_2 = "#4A6080";

    var boutonStyle = {
      "font-family": "'DM Sans', sans-serif",
      "font-size": "15px",
      "font-weight": "700",
      "letter-spacing": "0.01em",
      "padding-top": "15px",
      "padding-bottom": "15px",
      "padding-left": "30px",
      "padding-right": "30px",
      color: NAVY,
      "background-color": TEAL,
      "border-radius": "9999px",
      ":hover": { color: NAVY, "background-color": TEAL_FONCE },
      ":focus": { "background-color": TEAL_FONCE },
    };

    function demarrer() {
      var client = ShopifyBuy.buildClient({
        domain: shopify.domain,
        storefrontAccessToken: shopify.storefrontAccessToken,
      });

      ShopifyBuy.UI.onReady(client).then(function (ui) {
        shopifyProduits.forEach(function (p) {
          var noeud = document.getElementById(p.node);
          if (!noeud) return;

          ui.createComponent("product", {
            id: p.id,
            node: noeud,
            // Convention française : montant puis symbole (19,99 €)
            moneyFormat: "{{amount_with_comma_separator}} €",
            options: {
              product: {
                // La carte du site fournit déjà image, titre et prix.
                contents: { img: false, title: false, price: false, button: true },
                styles: {
                  product: {
                    "@media (min-width: 601px)": {
                      "max-width": "100%",
                      "margin-left": "0px",
                      "margin-bottom": "0px",
                    },
                  },
                  button: boutonStyle,
                },
                text: {
                  button: "Ajouter au panier",
                  outOfStock: "Épuisé",
                  unavailable: "Indisponible",
                },
                googleFonts: ["DM Sans"],
              },
              cart: {
                styles: {
                  button: boutonStyle,
                  title: { color: TEXTE },
                  header: { color: TEXTE },
                  lineItems: { color: TEXTE },
                  subtotalText: { color: TEXTE },
                  subtotal: { color: TEXTE },
                  notice: { color: TEXTE_2 },
                  currency: { color: TEXTE },
                  close: { color: TEXTE, ":hover": { color: NAVY } },
                  empty: { color: TEXTE_2 },
                  noteDescription: { color: TEXTE_2 },
                  discountText: { color: TEXTE_2 },
                  discountIcon: { fill: TEXTE_2 },
                  discountAmount: { color: TEXTE },
                },
                text: {
                  title: "Votre panier",
                  empty: "Votre panier est vide.",
                  button: "Passer commande",
                  total: "Sous-total",
                  notice: "Frais de livraison et codes promo calculés au paiement.",
                  noteDescription: "Instructions particulières",
                },
                popup: false,
                googleFonts: ["DM Sans"],
              },
              toggle: {
                styles: {
                  toggle: {
                    "font-family": "'DM Sans', sans-serif",
                    "background-color": NAVY,
                    ":hover": { "background-color": "#1A56CC" },
                    ":focus": { "background-color": "#1A56CC" },
                  },
                  count: { "font-size": "16px", "font-weight": "700" },
                },
                googleFonts: ["DM Sans"],
              },
            },
          });
        });
      });
    }

    if (window.ShopifyBuy && window.ShopifyBuy.UI) {
      demarrer();
    } else {
      var s = document.createElement("script");
      s.async = true;
      s.src = SDK;
      s.onload = demarrer;
      (document.head || document.body).appendChild(s);
    }
  })();
</script>

<style>
  /* ---------- Hero ---------- */
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 160px 0 80px;
  }
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(13,48,128,0.88) 0%, rgba(13,48,128,0.62) 60%, rgba(0,200,150,0.2) 100%);
    z-index: 1;
  }
  .page-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .page-hero .tag {
    background: rgba(0,200,150,0.2);
    color: var(--teal-clair);
    border: 1px solid rgba(0,200,150,0.3);
    align-self: flex-start;
  }
  .page-hero h1 { color: var(--blanc); }
  .page-hero .accent {
    background: linear-gradient(90deg, var(--teal), var(--teal-clair));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .page-hero p { color: rgba(255,255,255,0.75); max-width: 560px; }

  /* ---------- Bandeau réassurance ---------- */
  .reassurance {
    background: var(--bleu);
    color: rgba(255,255,255,0.72);
  }
  .reassurance-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-block: 28px;
  }
  .reassurance-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .reassurance-item svg {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--teal);
  }
  .reassurance-item div { display: flex; flex-direction: column; }
  .reassurance-item strong {
    color: var(--blanc);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .reassurance-item span { font-size: 0.8rem; line-height: 1.4; }

  /* ---------- Blocs communs produits ---------- */
  .eyebrow {
    font-family: var(--font-corps);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .soustitre {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--texte-2);
    margin-top: -4px;
  }
  .accroche { color: var(--texte-2); line-height: 1.7; }

  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--texte);
    line-height: 1.5;
  }
  .points li svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--teal);
  }

  .astuce {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--texte-2);
    background: var(--teal-pale);
    border-radius: var(--r-md);
    padding: 14px 18px;
  }
  .astuce strong { color: var(--bleu); }

  .reserve {
    font-size: 0.82rem;
    color: var(--gris);
    font-style: italic;
  }

  .achat {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 6px;
    padding-top: 22px;
    border-top: 1px solid rgba(13,48,128,0.1);
  }
  .prix-bloc { display: flex; flex-direction: column; }
  .prix {
    font-family: var(--font-titre);
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: var(--bleu);
    letter-spacing: -0.02em;
  }
  .prix-mention {
    font-size: 0.75rem;
    color: var(--gris);
    margin-top: 4px;
  }
  /* Hauteur réservée : évite le décalage quand le bouton Shopify se monte */
  .buy-mount { min-height: 52px; min-width: 190px; }

  .badge-contenance {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(6px);
    color: var(--bleu);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: var(--r-full);
  }

  /* ---------- Produit vedette ---------- */
  .vedette-section { padding-block: var(--section-gap) 0; }

  .vedette {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    align-items: center;
    background: linear-gradient(150deg, var(--blanc) 0%, var(--fond) 100%);
    border: 1px solid rgba(13,48,128,0.08);
    border-radius: var(--r-xl);
    padding: 40px;
    box-shadow: 0 24px 60px rgba(13,48,128,0.07);
  }
  .vedette-media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--blanc);
  }
  /* width + height explicites : neutralise les attributs HTML width/height
     (sinon l'image garde sa hauteur intrinsèque et fait exploser la carte) */
  .vedette-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vedette-corps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .vedette-corps h2 {
    color: var(--bleu);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
  }

  /* ---------- Grille ---------- */
  .grille-section { padding-block: var(--section-gap); }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-bottom: 56px;
  }
  .section-head h2 { color: var(--bleu); }
  .section-head p { color: var(--texte-2); max-width: 520px; }

  .grille {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .carte {
    display: flex;
    flex-direction: column;
    background: var(--blanc);
    border: 1px solid rgba(13,48,128,0.09);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .carte:hover {
    transform: translateY(-5px);
    border-color: rgba(0,200,150,0.4);
    box-shadow: 0 20px 44px rgba(13,48,128,0.12);
  }
  .carte-media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: linear-gradient(160deg, var(--blanc) 0%, var(--fond) 100%);
  }
  .carte-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .carte-corps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    flex: 1;
  }
  .carte-corps h3 { color: var(--bleu); }
  .carte-corps .achat { margin-top: auto; }
  .carte-corps .accroche { font-size: 0.95rem; }
  /* Dans la grille, le conseil reste une note discrète (l'encadré teal est
     réservé au produit vedette, sinon les cartes deviennent lourdes). */
  .carte-corps .astuce {
    background: none;
    padding: 0 0 0 14px;
    border-left: 2px solid var(--teal);
    border-radius: 0;
    font-size: 0.84rem;
  }

  /* ---------- Infos livraison ---------- */
  .infos-section {
    background: var(--fond);
    padding-block: var(--section-gap);
  }
  .infos-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: start;
  }
  .infos-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    position: sticky;
    top: 120px;
  }
  .infos-intro h2 { color: var(--bleu); }
  .infos-intro p { color: var(--texte-2); }

  .infos-liste {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .infos-liste li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block: 22px;
    border-bottom: 1px solid rgba(13,48,128,0.1);
  }
  .infos-liste li:first-child { padding-top: 0; }
  .infos-liste li:last-child { border-bottom: none; padding-bottom: 0; }
  .infos-liste strong {
    font-family: var(--font-titre);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--bleu);
